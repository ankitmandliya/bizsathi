# Frontend
VITE_API_BASE_URL=http://localhost:8000
# Set to false in production to hide demo credentials hint
VITE_SHOW_DEV_LOGIN_HINT=true

# Backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://bizsathi:bizsathi@localhost:5432/bizsathi
REDIS_URL=redis://localhost:6379/0

# PostgreSQL
POSTGRES_DB=bizsathi
POSTGRES_USER=bizsathi
POSTGRES_PASSWORD=bizsathi

# Docker
COMPOSE_PROJECT_NAME=bizsathi
